   "source": [
    "def my_decor(fn):\n",
    "    def inner():\n",
    "        print(\"Good morning\")\n",
    "        fn()\n",
    "        print(\"How are you\")\n",
    "    return inner\n",
    "@my_decor\n",
    "def greet():\n",
    "    name=input(\"Enter your name:\")\n",
    "    print(f'Hello {name}')"
   ]
  },
